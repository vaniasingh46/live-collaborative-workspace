# No database is needed for local development. Rooms and documents are stored
# in server/data/workspace.json (which is Git-ignored).
# Optional: override that location with an absolute or relative JSON file path.
# LOCAL_DATA_FILE="./data/workspace.json"

# Backend HTTP and Socket.IO port.
PORT=3001

# Browser origin permitted to call the API and connect via Socket.IO.
CLIENT_URL="http://localhost:5173"

NODE_ENV="development"
